# Copy to .env.local for local development, and set the same values in Vercel.

# Canonical site URL, used for metadata, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://peartreecompanies.com

# Google Tag Manager container (the one on the current WordPress site). Leave blank to disable.
NEXT_PUBLIC_GTM_ID=GTM-WLHPDWV7

# Where inquiry form submissions are POSTed as JSON (HighLevel inbound webhook, Zapier, etc.).
# Without it, submissions are logged to the console in development and fail with a message in production.
INQUIRY_WEBHOOK_URL=
